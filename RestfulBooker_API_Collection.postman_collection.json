    {
      "name": "Negative_Cases",
      "item": [
        {
          "name": "5. Invalid Authorization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "  url: \"https://restful-booker.herokuapp.com/booking\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\", \"Accept\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: JSON.stringify({ firstname: \"Unauthorized\", lastname: \"DeleteTest\", totalprice: 100, depositpaid: false, bookingdates: { checkin: \"2026-11-01\", checkout: \"2026-11-02\" }, additionalneeds: \"None\" }) }",
                  "}, function (err, res) {",
                  "  if (err) { console.error(\"Không tạo được booking phụ:\", err); return; }",
                  "  if (res.code === 200 && res.json().bookingid) { pm.environment.set(\"unauthorizedBookingId\", String(res.json().bookingid)); }",
                  "  else { console.error(\"Tạo booking phụ thất bại:\", res.code, res.text()); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Không có xác thực bị từ chối - Status 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Response là Forbidden\", function () { pm.expect(pm.response.text()).to.eql(\"Forbidden\"); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking/{{unauthorizedBookingId}}",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking",
                "{{unauthorizedBookingId}}"
              ]
            }
          },
          "response": []
        },
